TYPE "DobotCRInputStruct"
VERSION : 0.1
   STRUCT
      robotType : Byte;
      robotMode : Byte;
      reserve : Word := 16#0000;
      machineStatus : Byte;
      butttonSignal : Byte;
      motionStatus : Byte;
      reserve_1 : Byte;
      timestamp : Array[0..7] of Byte;
      speedRatio : Real;
      mainVoltage : Real;
      robotVoltage : Real;
      robotCurrent : Real;
      load : Real;
      centerX : Real;
      centerY : Real;
      centerZ : Real;
      safeSignal : Array[0..7] of Byte;
      ioInput : Array[0..3] of Byte;
      ioOuput : Array[0..3] of Byte;
      reserve_3 : Array[0..15] of Byte;
      qActual : Array[0..5] of Real;
      qDActual : Array[0..5] of Real;
      iActual : Array[0..5] of Real;
      motorTemperatures : Array[0..5] of Real;
      jointModes : Array[0..5] of Real;
      vActual : Array[0..5] of Real;
      toolVectorActual : Array[0..5] of Real;
      tcpSpeedActual : Array[0..5] of Real;
      bitOutputRegisters : Array[0..7] of Byte;
      dintOutputRegister : Array[0..23] of DInt;
      floatOutputRegister : Array[0..23] of Real;
   END_STRUCT;

END_TYPE

TYPE "DobotCROutputStruct"
VERSION : 0.1
   STRUCT
      speedRatio : Real;
      ioOurput : Array[0..3] of Byte;
      toolIOOutput : Array[0..3] of Byte;
      AO : Array[0..1] of Real;
      control : Array[0..3] of Byte;
      bitInputRegisters : Array[0..7] of Byte;
      dintInputRegisters : Array[0..23] of DInt;
      floatInputRegisters : Array[0..23] of Real;
   END_STRUCT;

END_TYPE
