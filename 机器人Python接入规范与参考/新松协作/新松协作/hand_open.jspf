{"name":"hand_open.jspf","modules":[{"tag":"Main","name":"Main","repeat":false,"tasks":[{"id":"MtnRtmzf_","tag":"Start","expanded":false,"disabled":true,"params":{"pose":{"type":"p","val":[-0.0999101,-0.48163253,1.95590078,0.09516552,-1.57157516,1.51603496],"name":""},"v":30}},{"id":"ukq0twIli","tag":"Script","expanded":false,"disabled":false,"params":{"type":"block","val":"local Cylinder_status={}--读取电缸状态存取变量Cylinder_status\r\n--[[\r\na=0x01\r\nb=0xF4\r\njiaoyan1=0x78\r\njiaoyan2=0x21\r\n]]\r\n\r\na=0x03\r\nb=0xE8\r\n\r\njiaoyan1=0x78\r\njiaoyan2=0x88\r\n\r\n\r\nwrite_raw_data_485({0x01,0x06,0x01,0x03,a,b,jiaoyan1,jiaoyan2}) --485通讯写入夹爪\r\n\r\nCylinder_status=read_raw_data_485(50,500)--读电缸状态\r\nlog(\"读取状态\",Cylinder_status)\r\n","comment":"夹爪打开","expr":""}},{"id":"oLKWnzcQ0","tag":"Script","expanded":false,"disabled":false,"params":{"type":"block","val":"  local Cylinder_status={}--读取电缸状态存取变量Cylinder_status\r\n  local actual_position=0--获取实际位置变量\r\n  \r\nwhile((actual_position ~=  1000))\r\ndo\r\n\r\n  \r\n    --[[\r\n    a=0x01\r\n    b=0xF4\r\n    jiaoyan1=0x78\r\n    jiaoyan2=0x21\r\n    ]]\r\n\r\n    a=0x00\r\n    b=0x01\r\n\r\n    jiaoyan1=0x24\r\n    jiaoyan2=0x72\r\n\r\n\r\n    write_raw_data_485({0x01,0x03,0x02,0x02,a,b,jiaoyan1,jiaoyan2}) --485通讯写入夹爪\r\n\r\n    Cylinder_status=read_raw_data_485(50,1000)--读电缸状态\r\n    log(\"读取状态\",Cylinder_status[5])\r\n    sleep(50)\r\n    -----------高低位转换并合并------------------------\r\n    \r\n    local data1=Cylinder_status[4]--接受的数据1\r\n    local data2=Cylinder_status[5]--接受的数据2\r\n\r\n    actual_position=bit32.lshift(data1,8)+data2--进行高低位转换并合并\r\n    log(\"actual_position\",actual_position)\r\n\r\n\r\n  sleep(100)\r\nend\r\n","comment":"夹爪打开位置状态反馈 ","expr":""}}],"expanded":true}],"variables":[]}