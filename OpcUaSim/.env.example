# 这些变量由 shell/系统环境读取；程序不会自动加载本文件。

# 可选：替换仓库内 data/demo_variables.csv
OPCUASIM_CSV=C:\path\to\your_variables.csv

# 以下仅在使用 InoProShop MCP 功能时需要
OPCUASIM_MCP_BUNDLE=C:\path\to\bundle.min.js
OPCUASIM_INOPROSHOP_EXE=C:\Program Files\Inovance Control\InoProShop\CODESYS\Common\InoProShop.exe
OPCUASIM_INOPROSHOP_PROFILE=InoProShop(V1.9.1.6)
OPCUASIM_MCP_WORKSPACE=C:\path\to\workspace
OPCUASIM_NODE=node

# 可选：指定自定义 MCP JSON；默认也会检查 ~/.cursor/mcp.json 和 ~/.mcp.json
OPCUASIM_MCP_CONFIG=C:\path\to\mcp.json
